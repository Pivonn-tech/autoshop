# CORS
CORS_ORIGIN=http://localhost:3000


# Email (Nodemailer) — fill in to enable transactional email
# For Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURE=false
# For Resend SMTP: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AutoFix Kenya <noreply@autofixkenya.co.ke>


# Object Storage (Cloudflare R2 / AWS S3 / MinIO)
# Leave S3_BUCKET blank to fall back to local disk storage.
# For Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# For AWS S3:        leave S3_ENDPOINT blank, set S3_REGION
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
