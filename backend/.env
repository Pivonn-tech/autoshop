# Backend Configuration
DATABASE_URL=postgresql://phil@localhost:5432/autoshop_db?host=/var/run/postgresql
NODE_ENV=development
PORT=3001

# JWT
JWT_SECRET=iKjleVqg7YU8K0EP+sHRlPVWKay9hCjSd33KZj47mMY=

# Stripe
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLIC_KEY=pk_test_YOUR_STRIPE_PUBLIC_KEY

# File Upload
UPLOAD_DIR=./uploads
